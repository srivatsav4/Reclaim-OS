# RECLAIM OS runs fully offline with these defaults. No secrets are required.
AI_MODE=demo                       # demo = deterministic local reasoning (no LLM, no API key)
# DATABASE_URL=sqlite:///absolute/path/to/reclaim.db   # default: <project>/data/reclaim.db (SQLite, zero config)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# STATIC_DIR=frontend/dist         # serve the built UI from the API process (default when the folder exists)
# VITE_API_TARGET=http://127.0.0.1:8000   # dev-server proxy target for `npm run dev`
